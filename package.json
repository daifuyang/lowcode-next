{
  "name": "lowcode-next",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @lowcode-next/playground-react dev",
    "dev:vue": "pnpm --filter @lowcode-next/playground-vue dev",
    "build": "pnpm build:types && pnpm -r --filter \"./apps/*\" build",
    "build:types": "tsc -b",
    "typecheck": "tsc -b && tsc -p apps/playground-react --noEmit && tsc -p apps/playground-vue --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf packages/*/dist apps/*/dist *.tsbuildinfo packages/*/*.tsbuildinfo"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
